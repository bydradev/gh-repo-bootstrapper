// markdownlint configuration for the Markdown that bootstrap.py generates.
// validate.yml renders every configuration with
// `python validate_templates.py --render-markdown <dir>` and lints the result.
// It also lints this repository's own Markdown with the same rules.
{
  "config": {
    // Template prose is wrapped by hand; commands and URLs run long.
    "MD013": false,
    // CLAUDE.md is a single `@AGENTS.md` import with no heading.
    "MD041": false,
    // README tables use compact pipes.
    "MD060": false
  }
}
